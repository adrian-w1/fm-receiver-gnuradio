- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"FM-Demodulator:\
      \ m[n] = gain * arg(x[n] * conj(x[n-1]))\"\"\"\n\n    def __init__(self, gain=1.0):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='My FM\
      \ Demod',\n            in_sig=[np.complex64],\n            out_sig=[np.float32],\n\
      \        )\n        self.gain = gain\n        self.last = np.complex64(1.0)\
      \  \n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        prev = np.concatenate(([self.last], x[:-1]))\n        output_items[0][:]\
      \ = self.gain * np.angle(x * np.conj(prev))\n        self.last = x[-1]\n   \
      \     return len(x)"
    affinity: ''
    alias: ''
    comment: ''
    gain: samp_rate/(2*3.14159*75000)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''My FM Demod'', ''blk'', [(''gain'', ''1.0'')], [(''0'', ''complex'',
      1)], [(''0'', ''float'', 1)], ''FM-Demodulator: m[n] = gain * arg(x[n] * conj(x[n-1]))'',
      [''gain''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 240.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from scipy.signal import lfilter\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"De-Emphasis: y[n] = alpha*x[n] + (1-alpha)*y[n-1]\"\"\"\n\n    def\
      \ __init__(self, fs=48000.0, tau=50e-6):\n        gr.sync_block.__init__(self,\
      \ name='My Deemphasis',\n                               in_sig=[np.float32],\
      \ out_sig=[np.float32])\n        alpha = 1.0 - np.exp(-1.0 / (fs * tau))\n \
      \       self.b = [alpha]\n        self.a = [1.0, -(1.0 - alpha)]\n        self.zi\
      \ = np.zeros(1)\n\n    def work(self, input_items, output_items):\n        y,\
      \ self.zi = lfilter(self.b, self.a, input_items[0], zi=self.zi)\n        output_items[0][:]\
      \ = y\n        return len(y)\n"
    affinity: ''
    alias: ''
    comment: ''
    fs: '50000'
    maxoutbuf: '0'
    minoutbuf: '0'
    tau: 50e-6
  states:
    _io_cache: '(''My Deemphasis'', ''blk'', [(''fs'', ''48000.0''), (''tau'', ''5e-05'')],
      [(''0'', ''float'', 1)], [(''0'', ''float'', 1)], ''De-Emphasis: y[n] = alpha*x[n]
      + (1-alpha)*y[n-1]'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 240.0]
    rotation: 0
    state: enabled
